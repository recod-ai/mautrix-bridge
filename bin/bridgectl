#!/usr/bin/env python3
"""
bridgectl — gerenciador de pontes mautrix rodando localmente.

- Baixa/atualiza os binários Go pré-compilados (GitHub releases ou CI do mau.dev).
- Mantém os segredos no chaveiro do Linux (python-keyring).
- Renderiza config.yaml/registration.yaml em tmpfs na hora de subir a ponte.
- Um único systemd --user template serve todas as pontes: mautrix-bridge@discord etc.

Requer Python 3.11+ (tomllib) e o pacote `keyring`.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import platform
import re
import shutil
import stat
import sys
import time
import tomllib
import urllib.error
import urllib.request
from pathlib import Path
from typing import Any

APP = "mautrix-bridges"
UA = "bridgectl/1.0 (+https://docs.mau.fi/bridges/)"

CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / APP
DATA_DIR = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / APP
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / APP
BIN_DIR = DATA_DIR / "bin"

PLACEHOLDER = re.compile(r"\$\{keyring:([^}]+)\}")

ARCH_MAP = {
    "x86_64": "amd64",
    "amd64": "amd64",
    "aarch64": "arm64",
    "arm64": "arm64",
    "armv7l": "arm",
    "armv6l": "arm",
}


# --------------------------------------------------------------------------- #
# utilidades
# --------------------------------------------------------------------------- #

def log(msg: str) -> None:
    print(f"[bridgectl] {msg}", file=sys.stderr, flush=True)


def die(msg: str, code: int = 1) -> None:
    print(f"[bridgectl] ERRO: {msg}", file=sys.stderr, flush=True)
    raise SystemExit(code)


def http_json(url: str, timeout: int = 15) -> Any:
    headers = {"User-Agent": UA, "Accept": "application/json"}
    token = os.environ.get("GITHUB_TOKEN") or os.environ.get("GH_TOKEN")
    if token and "api.github.com" in url:
        # Sem token o limite é 60 req/h por IP — fácil de estourar com várias
        # pontes + cooldown baixo. Com token (mesmo sem escopo nenhum) sobe pra 5000/h.
        headers["Authorization"] = f"Bearer {token}"
    req = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return json.load(resp)


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def runtime_dir(name: str) -> Path:
    """Diretório em tmpfs onde os arquivos com segredo são materializados."""
    env = os.environ.get("RUNTIME_DIRECTORY")  # setado pelo systemd (RuntimeDirectory=)
    if env:
        return Path(env.split(":")[0])
    base = os.environ.get("XDG_RUNTIME_DIR")
    d = Path(base) / f"mautrix-{name}" if base else Path("/dev/shm") / f"mautrix-{name}-{os.getuid()}"
    d.mkdir(parents=True, exist_ok=True)
    os.chmod(d, 0o700)
    return d


# --------------------------------------------------------------------------- #
# configuração
# --------------------------------------------------------------------------- #

DEFAULTS = {
    "channel": "release",       # "release" (GitHub) ou "ci" (mau.dev, branch main)
    "arch": ARCH_MAP.get(platform.machine(), "amd64"),
    "keyring_service": "",      # vazio => "mautrix-<nome da ponte>"
    "update_cooldown": 900,     # segundos entre checagens automáticas
    "args": [],
}


def load_config() -> dict:
    path = CONFIG_DIR / "bridges.toml"
    if not path.exists():
        die(f"não encontrei {path} — copie o bridges.toml de exemplo para lá")
    with path.open("rb") as f:
        raw = tomllib.load(f)
    defaults = {**DEFAULTS, **raw.get("defaults", {})}
    bridges = {}
    for name, spec in raw.get("bridges", {}).items():
        merged = {**defaults, **spec}
        merged.setdefault("repo", name)
        if not merged.get("keyring_service"):
            merged["keyring_service"] = f"mautrix-{name}"
        merged.setdefault("binary", f"mautrix-{name}")
        merged["name"] = name
        bridges[name] = merged
    if not bridges:
        die("nenhuma ponte declarada em [bridges.*] no bridges.toml")
    return {"defaults": defaults, "bridges": bridges, "server": raw.get("server", {}), "wireguard": raw.get("wireguard", {})}


def get_bridge(cfg: dict, name: str) -> dict:
    if name not in cfg["bridges"]:
        die(f"ponte '{name}' não está no bridges.toml (tenho: {', '.join(cfg['bridges'])})")
    return cfg["bridges"][name]


def state_path(name: str) -> Path:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    return STATE_DIR / f"{name}.json"


def read_state(name: str) -> dict:
    p = state_path(name)
    if p.exists():
        try:
            return json.loads(p.read_text())
        except json.JSONDecodeError:
            return {}
    return {}


def write_state(name: str, data: dict) -> None:
    state_path(name).write_text(json.dumps(data, indent=2) + "\n")


# --------------------------------------------------------------------------- #
# descoberta de versão / download
# --------------------------------------------------------------------------- #

def latest_release(repo: str, binary: str, arch: str) -> tuple[str, str]:
    """Última release no GitHub -> (versão, url do asset)."""
    data = http_json(f"https://api.github.com/repos/mautrix/{repo}/releases/latest")
    tag = data.get("tag_name") or "unknown"
    assets = data.get("assets", [])

    def score(asset: dict) -> int:
        n = asset.get("name", "").lower()
        if "macos" in n or "darwin" in n or "windows" in n or n.endswith(".sig"):
            return -1
        if arch not in n:
            return -1
        s = 10
        if n.startswith(binary):
            s += 5
        if "linux" in n:
            s += 2
        return s

    best = max(assets, key=score, default=None)
    if best is None or score(best) < 0:
        names = ", ".join(a.get("name", "?") for a in assets) or "(nenhum)"
        raise RuntimeError(f"nenhum asset para arch={arch} na release {tag} de mautrix/{repo}. Assets: {names}")
    return tag, best["browser_download_url"]


def latest_ci(repo: str, binary: str, arch: str) -> tuple[str, str]:
    """Último pipeline verde do branch main no mau.dev -> (sha curto, url do artefato)."""
    pipelines = http_json(
        f"https://mau.dev/api/v4/projects/mautrix%2F{repo}/pipelines"
        f"?ref=main&status=success&per_page=1"
    )
    if not pipelines:
        raise RuntimeError(f"nenhum pipeline verde em mau.dev/mautrix/{repo} (branch main)")
    sha = pipelines[0].get("sha", "")[:12] or "unknown"
    url = (
        f"https://mau.dev/mautrix/{repo}/-/jobs/artifacts/main/raw/{binary}"
        f"?job=build%20{arch}"
    )
    return f"ci-{sha}", url


def download(url: str, dest: Path) -> None:
    dest.parent.mkdir(parents=True, exist_ok=True)
    tmp = dest.with_suffix(dest.suffix + ".partial")
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    with urllib.request.urlopen(req, timeout=180) as resp, tmp.open("wb") as out:
        shutil.copyfileobj(resp, out, length=1 << 20)

    # Sanidade: CI expirado / redirect de login devolve HTML, não um ELF.
    with tmp.open("rb") as f:
        magic = f.read(4)
    size = tmp.stat().st_size
    if magic != b"\x7fELF" or size < 1_000_000:
        tmp.unlink(missing_ok=True)
        raise RuntimeError(f"download não parece um binário Linux (magic={magic!r}, {size} bytes) — url: {url}")

    tmp.chmod(tmp.stat().st_mode | stat.S_IXUSR | stat.S_IXGRP)
    os.replace(tmp, dest)  # atômico; se a ponte antiga estiver rodando, ela segue no inode antigo


def cmd_update(cfg: dict, args: argparse.Namespace) -> int:
    names = list(cfg["bridges"]) if args.all else [args.name]
    rc = 0
    for name in names:
        b = get_bridge(cfg, name)
        st = read_state(name)
        target = BIN_DIR / b["binary"]

        if not args.force and target.exists():
            elapsed = time.time() - st.get("checked_at", 0)
            if elapsed < b["update_cooldown"]:
                if not args.quiet:
                    log(f"{name}: checado há {int(elapsed)}s, pulando (cooldown {b['update_cooldown']}s)")
                continue

        try:
            if b["channel"] == "ci":
                version, url = latest_ci(b["repo"], b["binary"], b["arch"])
            else:
                version, url = latest_release(b["repo"], b["binary"], b["arch"])
        except (urllib.error.URLError, TimeoutError, RuntimeError) as e:
            # Offline ou CI fora do ar não pode impedir a ponte de subir com o binário atual.
            log(f"{name}: não consegui checar atualizações ({e})")
            if not target.exists():
                rc = 1
            continue

        st["checked_at"] = time.time()

        if target.exists() and st.get("version") == version and not args.force:
            if not args.quiet:
                log(f"{name}: já está em {version}")
            write_state(name, st)
            continue

        log(f"{name}: baixando {version} ({b['arch']}, canal {b['channel']})")
        try:
            download(url, target)
        except (urllib.error.URLError, TimeoutError, RuntimeError) as e:
            log(f"{name}: download falhou ({e})")
            write_state(name, st)
            if not target.exists():
                rc = 1
            continue

        st.update({"version": version, "url": url, "sha256": sha256_file(target),
                   "installed_at": time.time(), "arch": b["arch"], "channel": b["channel"]})
        write_state(name, st)
        log(f"{name}: instalado {version} em {target}")
    return rc


# --------------------------------------------------------------------------- #
# segredos
# --------------------------------------------------------------------------- #

def keyring_mod():
    try:
        import keyring  # noqa: PLC0415
    except ImportError:
        die("pacote 'keyring' não instalado (pacman -S python-keyring / pip install keyring)")
    return keyring


def resolve_secret(ref: str, default_service: str) -> str | None:
    service, _, key = ref.rpartition("/")
    return keyring_mod().get_password(service or default_service, key)


def render(text: str, name: str, default_service: str) -> str:
    missing: list[str] = []

    def sub(m: re.Match) -> str:
        ref = m.group(1)
        val = resolve_secret(ref, default_service)
        if val is None:
            missing.append(ref)
            return ""
        return val

    out = PLACEHOLDER.sub(sub, text)
    if missing:
        die(f"{name}: segredos ausentes no chaveiro: {', '.join(sorted(set(missing)))}\n"
            f"           use: bridgectl set {name} <chave>")
    return out


def cmd_set(cfg: dict, args: argparse.Namespace) -> int:
    import getpass
    b = get_bridge(cfg, args.name)
    service = args.service or b["keyring_service"]
    value = args.value or getpass.getpass(f"valor para {service}/{args.key}: ")
    if not value:
        die("valor vazio")
    keyring_mod().set_password(service, args.key, value)
    log(f"gravado {service}/{args.key} no chaveiro")
    return 0


HARVEST_KEYS = [
    "as_token", "hs_token", "login_shared_secret", "shared_secret",
    "uri", "pickle_key", "provisioning_shared_secret",
]


def cmd_harvest(cfg: dict, args: argparse.Namespace) -> int:
    """Tira segredos de um config/registration já pronto e põe no chaveiro, deixando placeholders."""
    b = get_bridge(cfg, args.name)
    service = b["keyring_service"]
    path = Path(args.file)
    if not path.exists():
        die(f"{path} não existe")

    keys = args.keys.split(",") if args.keys else HARVEST_KEYS
    kr = keyring_mod()
    out_lines, moved = [], []

    for line in path.read_text().splitlines():
        m = re.match(r"^(\s*)([A-Za-z0-9_]+):\s*(.+?)\s*$", line)
        if m and m.group(2) in keys:
            indent, key, raw = m.groups()
            # raw still carries whatever quoting was in the file (harvest
            # always writes its placeholders quoted), so the "already
            # harvested" check has to look at the unquoted value — checking
            # raw itself would never match a quoted placeholder, and a
            # second harvest of an already-harvested file would treat
            # '"${keyring:as_token}"' as a literal secret and overwrite the
            # real value in the keyring with that placeholder string.
            value = raw.strip('"').strip("'")
            if value.startswith("${keyring:") or value in {"null", "~", ""}:
                out_lines.append(line)
                continue
            kname = f"{args.name}_{key}" if args.prefix else key
            kr.set_password(service, kname, value)
            out_lines.append(f'{indent}{key}: "${{keyring:{kname}}}"')
            moved.append(f"{service}/{kname}")
        else:
            out_lines.append(line)

    if not moved:
        log("nada para mover (nenhuma chave conhecida com valor literal)")
        return 0

    backup = path.with_suffix(path.suffix + ".orig")
    if not backup.exists():
        shutil.copy2(path, backup)
        os.chmod(backup, 0o600)
    path.write_text("\n".join(out_lines) + "\n")
    os.chmod(path, 0o600)
    log(f"movidos para o chaveiro: {', '.join(moved)}")
    log(f"cópia original (ainda com segredos!) em {backup} — apague depois de conferir")
    return 0


# --------------------------------------------------------------------------- #
# execução
# --------------------------------------------------------------------------- #

def wait_for_keyring(service: str, probe: str, timeout: int) -> None:
    """O chaveiro do GNOME/KDE só abre depois do login gráfico; espera em vez de morrer."""
    if timeout <= 0:
        return
    kr = keyring_mod()
    deadline = time.time() + timeout
    while True:
        try:
            if kr.get_password(service, probe) is not None:
                return
        except Exception as e:  # cofre trancado, D-Bus ainda não subiu, etc.
            last = e
        else:
            last = None
        if time.time() >= deadline:
            if last:
                die(f"chaveiro indisponível após {timeout}s: {last}")
            return
        time.sleep(3)


def cmd_run(cfg: dict, args: argparse.Namespace) -> int:
    b = get_bridge(cfg, args.name)
    binary = BIN_DIR / b["binary"]
    if not binary.exists():
        die(f"binário {binary} não existe — rode: bridgectl update {args.name} --force")

    src_dir = CONFIG_DIR / args.name
    cfg_src = src_dir / "config.yaml"
    reg_src = src_dir / "registration.yaml"
    if not cfg_src.exists():
        die(f"{cfg_src} não existe — rode 'bridgectl setup {args.name}'")

    probe = b.get("keyring_probe")
    if probe:
        wait_for_keyring(b["keyring_service"], probe, int(b.get("keyring_wait", 120)))

    rd = runtime_dir(args.name)
    cfg_dst = rd / "config.yaml"
    cfg_dst.write_text(render(cfg_src.read_text(), args.name, b["keyring_service"]))
    os.chmod(cfg_dst, 0o600)

    argv = [str(binary), "-c", str(cfg_dst)]
    if reg_src.exists():
        reg_dst = rd / "registration.yaml"
        reg_dst.write_text(render(reg_src.read_text(), args.name, b["keyring_service"]))
        os.chmod(reg_dst, 0o600)
        argv += ["-r", str(reg_dst)]
    argv += list(b.get("args", [])) + list(args.extra)

    workdir = Path(b.get("workdir") or (DATA_DIR / args.name))
    workdir.mkdir(parents=True, exist_ok=True)
    os.chmod(workdir, 0o700)  # o banco da ponte (sessão do Slack/Discord) mora aqui
    os.chdir(workdir)

    log(f"exec {b['binary']} ({read_state(args.name).get('version', '?')}) — config em {cfg_dst}")
    os.execv(argv[0], argv)  # substitui o processo: o systemd passa a supervisionar a ponte


def cmd_reveal(cfg: dict, args: argparse.Namespace) -> int:
    """Renderiza o registration.yaml de volta com os valores reais do chaveiro.

    O registration.yaml em ~/.config fica com placeholders (harvest trata ele
    igual ao config.yaml, pra nunca sobrar segredo em texto puro em disco) —
    mas o Synapse não entende ${keyring:...}, ele só lê o YAML literal. Esse
    comando existe só pra gerar, na hora, a cópia de verdade que vai pro
    administrador; não deixe essa saída sobrando em disco depois de enviada."""
    b = get_bridge(cfg, args.name)
    path = CONFIG_DIR / args.name / "registration.yaml"
    if not path.exists():
        die(f"{path} não existe — rode 'bridgectl setup {args.name}' primeiro")
    text = render(path.read_text(), args.name, b["keyring_service"])
    if args.out:
        out = Path(args.out)
        out.write_text(text)
        os.chmod(out, 0o600)
        log(f"registration.yaml (valores reais) escrito em {out} — "
            f"apague depois de enviar pro administrador")
    else:
        sys.stdout.write(text)
    return 0


def fetch_legacy_example_config(repo: str, dest: Path) -> None:
    """Pontes legadas (sem a flag '-e' de auto-config, ex: mautrix-discord) não
    geram um config de exemplo sozinhas — o example-config.yaml mora solto no
    repositório da ponte no GitHub. Baixa exatamente esse arquivo, tentando os
    dois nomes de branch default que o GitHub usa hoje em dia."""
    last_error = None
    for branch in ("main", "master"):
        url = f"https://raw.githubusercontent.com/mautrix/{repo}/{branch}/example-config.yaml"
        try:
            req = urllib.request.Request(url, headers={"User-Agent": UA})
            with urllib.request.urlopen(req, timeout=30) as resp:
                text = resp.read().decode("utf-8")
            dest.parent.mkdir(parents=True, exist_ok=True)
            dest.write_text(text)
            log(f"example-config.yaml baixado de {url}")
            return
        except urllib.error.HTTPError as e:
            last_error = e
            continue
        except urllib.error.URLError as e:
            die(f"não consegui baixar {url}: {e}")
    die(f"não encontrei example-config.yaml em https://github.com/mautrix/{repo} "
        f"(tentei main e master, {last_error}) — baixe manualmente e salve como {dest}")


def cmd_bootstrap(cfg: dict, args: argparse.Namespace) -> int:
    """Gera config/registration de exemplo no diretório da ponte, para você editar."""
    b = get_bridge(cfg, args.name)
    binary = BIN_DIR / b["binary"]
    if not binary.exists():
        die(f"binário {binary} não existe — rode antes: bridgectl update {args.name} --force")
    dst = CONFIG_DIR / args.name
    dst.mkdir(parents=True, exist_ok=True)
    cfg_file = dst / "config.yaml"
    if cfg_file.exists() and not args.force:
        die(f"{cfg_file} já existe (use --force para sobrescrever)")

    import subprocess
    r = subprocess.run([str(binary), "-e", "-c", str(cfg_file)], capture_output=True, text=True)
    if r.returncode != 0 or not cfg_file.exists():
        log(f"'{b['binary']} -e' não funcionou (pontes legadas, como {args.name}, não têm essa "
            f"flag) — baixando o example-config.yaml do repositório.")
        fetch_legacy_example_config(b["repo"], cfg_file)
    os.chmod(cfg_file, 0o600)
    log(f"config de exemplo em {cfg_file}")
    if not getattr(args, "quiet_hint", False):
        log("edite os campos do servidor à mão, ou rode:")
        log(f"  bridgectl setup {args.name}   # preenche o servidor, gera o registration e harvesta sozinho")
    return 0


MXID_RE = re.compile(r"^@([^:]+):(.+)$")


def cmd_init(cfg: dict, args: argparse.Namespace) -> int:
    """Pergunta os dados do servidor uma única vez e grava em [server] no bridges.toml.
    Se já houver uma configuração, mostra o que está gravado e só pergunta de novo se o
    usuário confirmar que quer editar — nesse caso, os valores atuais viram o default de
    cada campo (Enter mantém o que já estava lá)."""
    existing = cfg.get("server", {})
    if existing.get("homeserver_domain"):
        print("Já existe uma configuração de servidor:")
        print(f"  domínio do Synapse:      {existing.get('homeserver_domain')}")
        print(f"  endereço do Synapse:     {existing.get('homeserver_address')}")
        print(f"  seu IP na VPN:           {existing.get('vpn_ip')}")
        print(f"  dono das pontes:         {existing.get('owner_mxid') or '(nenhum)'}")
        if input("\nEditar esses valores? [s/N]: ").strip().lower() not in ("s", "sim", "y", "yes"):
            log("nada mudou")
            return 0
        print()

    print("Configuração do servidor (usada por 'bridgectl setup' em todas as pontes)\n")

    default_domain = existing.get("homeserver_domain", "")
    domain = input(
        f"Domínio do seu Synapse (server_name, ex: matrix.exemplo.com)"
        + (f" [{default_domain}]: " if default_domain else ": ")
    ).strip() or default_domain
    if not domain:
        die("domínio é obrigatório")

    # Esse é o endereço que A PONTE usa pra falar com o Synapse (saída) — é tráfego
    # normal de cliente HTTPS, não precisa de VPN pra isso, mesmo a ponte rodando
    # em outra máquina. Convenção comum: subdomínio "matrix." do domínio do servidor.
    default_address = existing.get("homeserver_address") or f"https://matrix.{domain}"
    address = input(
        f"Endereço público do Synapse (HTTPS, o mesmo que seu Element usa) [{default_address}]: "
    ).strip() or default_address

    # Esse já é o sentido contrário: o Synapse chamando DE VOLTA a ponte (webhook do
    # appservice) — like a ponte roda atrás de NAT, só chega até ela pela VPN. É por
    # isso que existe um campo separado do endereço acima.
    default_vpn_ip = existing.get("vpn_ip", "")
    vpn_ip = input(
        "Seu IP nesta VPN WireGuard (o administrador te deu, ex: 10.10.0.2)"
        + (f" [{default_vpn_ip}]: " if default_vpn_ip else ": ")
    ).strip() or default_vpn_ip
    if not vpn_ip:
        die("IP na VPN é obrigatório — sem ele o Synapse não consegue chamar sua ponte de volta")
    if not re.match(r"^\d{1,3}(\.\d{1,3}){3}$", vpn_ip):
        die(f"'{vpn_ip}' não parece um IPv4 (ex: 10.10.0.2)")

    default_owner = existing.get("owner_mxid", "")
    owner = input(
        "Seu Matrix ID (dono das suas pontes — ganha o nível de permissão "
        "'admin' *dentro* de cada ponte, sem relação com ser admin do Synapse; "
        "ex: @voce:matrix.exemplo.com"
        + (f") [{default_owner}]: " if default_owner else ", deixe em branco pra pular): ")
    ).strip() or default_owner

    if owner:
        m = MXID_RE.match(owner)
        if not m:
            die(f"'{owner}' não parece um Matrix ID válido (formato esperado: @usuario:{domain})")
        owner_domain = m.group(2)
        if owner_domain != domain:
            log(f"AVISO: '{owner}' é do domínio '{owner_domain}', diferente do servidor que "
                f"você configurou ('{domain}'). Esse Matrix ID vai virar o dono de todas as "
                f"pontes que você configurar a partir de agora — confira que é mesmo a sua conta.")
            if input("Confirma mesmo assim? [s/N]: ").strip().lower() not in ("s", "sim", "y", "yes"):
                die("cancelado — rode 'bridgectl init' de novo com o Matrix ID correto")

    print("\nConfira antes de gravar:")
    print(f"  domínio do Synapse:      {domain}")
    print(f"  endereço do Synapse:     {address}")
    print(f"  seu IP na VPN:           {vpn_ip}")
    print(f"  dono das pontes:         {owner or '(nenhum)'}")
    if input("Gravar em bridges.toml? [S/n]: ").strip().lower() not in ("", "s", "sim", "y", "yes"):
        die("cancelado, nada foi gravado")

    path = CONFIG_DIR / "bridges.toml"
    text = path.read_text() if path.exists() else ""
    block = (
        f'[server]\nhomeserver_domain = "{domain}"\nhomeserver_address = "{address}"\n'
        f'vpn_ip = "{vpn_ip}"\n'
    )
    if owner:
        block += f'owner_mxid = "{owner}"\n'

    if re.search(r"(?m)^\[server\]", text):
        text = re.sub(r"(?ms)^\[server\].*?(?=^\[|\Z)", block + "\n", text, count=1)
    else:
        text = block + "\n" + text
    path.write_text(text)
    log(f"servidor salvo em {path}")
    log("agora rode: bridgectl setup <ponte>  (uma vez por ponte)")
    return 0


# --------------------------------------------------------------------------- #
# VPN (WireGuard <-> NetworkManager)
# --------------------------------------------------------------------------- #

WG_KEYRING_SERVICE = "bridgectl-wireguard"
WG_KEYRING_KEY = "private_key"
VPN_CONN_NAME = "bridgectl-vpn"

# Token pessoal mostrado em /propylaia — não é a chave WireGuard, é o que
# autentica bridgectl (não um navegador) pra buscar as credenciais já
# pré-registradas no pool de pontes (ver fetch_pool_slot/POOL_BRIDGE_TYPES
# abaixo e docs/ADICIONAR-PONTE.md "Pool de pontes" no repo agorae).
PROPYLAIA_KEYRING_SERVICE = "bridgectl-propylaia"
PROPYLAIA_KEYRING_KEY = "api_token"


def cmd_vpn_init(cfg: dict, args: argparse.Namespace) -> int:
    """Pergunta os dados do peer WireGuard do servidor uma única vez e grava em
    [wireguard] no bridges.toml (e o token de API do propylaia no chaveiro).
    Mesma lógica de 'init': se já existir, mostra o que está gravado e só
    edita se confirmado, com os valores atuais como default."""
    existing = cfg.get("wireguard", {})
    kr = keyring_mod()
    existing_token = kr.get_password(PROPYLAIA_KEYRING_SERVICE, PROPYLAIA_KEYRING_KEY)
    if existing.get("server_public_key"):
        print("Já existe uma configuração de VPN:")
        print(f"  chave pública do servidor:  {existing.get('server_public_key')}")
        print(f"  endereço do servidor:       {existing.get('endpoint')}")
        print(f"  IP do servidor na VPN:      {existing.get('server_vpn_ip')}")
        print(f"  token de API (propylaia):   {'(gravado)' if existing_token else '(nenhum)'}")
        if input("\nEditar esses valores? [s/N]: ").strip().lower() not in ("s", "sim", "y", "yes"):
            log("nada mudou")
            return 0
        print()

    print("Configuração da VPN WireGuard (usada por 'bridgectl vpn')\n")

    default_pubkey = existing.get("server_public_key", "")
    pubkey = input(
        "Chave pública do servidor WireGuard (o administrador te deu)"
        + (f" [{default_pubkey}]: " if default_pubkey else ": ")
    ).strip() or default_pubkey
    if not pubkey:
        die("chave pública do servidor é obrigatória")

    default_endpoint = existing.get("endpoint", "")
    endpoint = input(
        "Endereço do servidor (host:porta, ex: boule.exemplo.com:51820)"
        + (f" [{default_endpoint}]: " if default_endpoint else ": ")
    ).strip() or default_endpoint
    if not endpoint:
        die("endereço do servidor é obrigatório")

    default_server_vpn_ip = existing.get("server_vpn_ip", "")
    server_vpn_ip = input(
        "IP do servidor dentro da VPN (ex: 10.10.0.1)"
        + (f" [{default_server_vpn_ip}]: " if default_server_vpn_ip else ": ")
    ).strip() or default_server_vpn_ip
    if not server_vpn_ip:
        die("IP do servidor na VPN é obrigatório")
    if not re.match(r"^\d{1,3}(\.\d{1,3}){3}$", server_vpn_ip):
        die(f"'{server_vpn_ip}' não parece um IPv4")

    default_token_shown = "(mantém o já gravado)" if existing_token else "(deixe em branco pra pular)"
    token = input(
        f"Token de API do propylaia (mostrado em /propylaia, pra 'setup' buscar sozinho "
        f"Discord/Slack/WhatsApp pré-registrados) {default_token_shown}: "
    ).strip()

    print("\nConfira antes de gravar:")
    print(f"  chave pública do servidor:  {pubkey}")
    print(f"  endereço do servidor:       {endpoint}")
    print(f"  IP do servidor na VPN:      {server_vpn_ip}")
    print(f"  token de API (propylaia):   {'(novo valor colado)' if token else default_token_shown}")
    if input("Gravar? [S/n]: ").strip().lower() not in ("", "s", "sim", "y", "yes"):
        die("cancelado, nada foi gravado")

    path = CONFIG_DIR / "bridges.toml"
    text = path.read_text() if path.exists() else ""
    block = (
        f'[wireguard]\nserver_public_key = "{pubkey}"\nendpoint = "{endpoint}"\n'
        f'server_vpn_ip = "{server_vpn_ip}"\n'
    )
    if re.search(r"(?m)^\[wireguard\]", text):
        text = re.sub(r"(?ms)^\[wireguard\].*?(?=^\[|\Z)", block + "\n", text, count=1)
    else:
        text = block + "\n" + text
    path.write_text(text)
    if token:
        kr.set_password(PROPYLAIA_KEYRING_SERVICE, PROPYLAIA_KEYRING_KEY, token)
        log("token de API gravado no chaveiro")
    log(f"gravado em {path}")
    log("agora rode: bridgectl vpn")
    return 0


def cmd_vpn(cfg: dict, args: argparse.Namespace) -> int:
    """Gera (ou reaproveita) seu par de chaves WireGuard — a privada nunca toca
    disco fora de um arquivo temporário apagado no fim deste comando — e importa
    a conexão no NetworkManager, com a chave movida pro chaveiro do sistema."""
    import subprocess
    import tempfile

    wg_cfg = cfg.get("wireguard", {})
    server_pubkey = wg_cfg.get("server_public_key")
    endpoint = wg_cfg.get("endpoint")
    server_vpn_ip = wg_cfg.get("server_vpn_ip")
    client_vpn_ip = cfg.get("server", {}).get("vpn_ip")

    if not (server_pubkey and endpoint and server_vpn_ip):
        die("rode 'bridgectl vpn-init' primeiro (dados do peer do servidor ainda não configurados)")
    if not client_vpn_ip:
        die("rode 'bridgectl init' primeiro (seu IP nesta VPN ainda não está configurado)")
    if shutil.which("nmcli") is None:
        die("'nmcli' não encontrado — instale o NetworkManager (ex: pacman -S networkmanager)")
    if shutil.which("wg") is None:
        die("'wg' não encontrado — instale o wireguard-tools")

    kr = keyring_mod()
    private_key = kr.get_password(WG_KEYRING_SERVICE, WG_KEYRING_KEY)
    if private_key:
        log("reaproveitando a chave WireGuard já existente no chaveiro")
    else:
        private_key = subprocess.run(["wg", "genkey"], capture_output=True, text=True, check=True).stdout.strip()
        kr.set_password(WG_KEYRING_SERVICE, WG_KEYRING_KEY, private_key)
        log("chave WireGuard nova gerada e gravada no chaveiro")

    public_key = subprocess.run(
        ["wg", "pubkey"], input=private_key, capture_output=True, text=True, check=True
    ).stdout.strip()
    print(f"\nSua chave pública: {public_key}")
    print("Cole essa chave onde o administrador do seu servidor pediu (ex.: a página "
          "/propylaia da agorae) antes de continuar.\n")
    if input("Já registrou a chave e quer conectar agora? [S/n]: ").strip().lower() not in ("", "s", "sim", "y", "yes"):
        log("ok — rode 'bridgectl vpn' de novo quando tiver registrado")
        return 0

    before = subprocess.run(
        ["nmcli", "-t", "-f", "NAME", "connection", "show"], capture_output=True, text=True
    ).stdout.splitlines()

    if VPN_CONN_NAME in before:
        log(f"conexão '{VPN_CONN_NAME}' já existe, só subindo")
        return subprocess.run(["nmcli", "connection", "up", VPN_CONN_NAME]).returncode

    tmp = Path(tempfile.mkstemp(suffix=".conf")[1])
    try:
        tmp.write_text(
            f"[Interface]\nPrivateKey = {private_key}\nAddress = {client_vpn_ip}/24\n\n"
            f"[Peer]\nPublicKey = {server_pubkey}\nEndpoint = {endpoint}\n"
            f"AllowedIPs = {server_vpn_ip}/32\nPersistentKeepalive = 25\n"
        )
        os.chmod(tmp, 0o600)
        r = subprocess.run(
            ["nmcli", "connection", "import", "type", "wireguard", "file", str(tmp)],
            capture_output=True, text=True,
        )
        if r.returncode != 0:
            die(f"'nmcli connection import' falhou: {r.stderr.strip()}")

        after = subprocess.run(
            ["nmcli", "-t", "-f", "NAME", "connection", "show"], capture_output=True, text=True
        ).stdout.splitlines()
        new_name = next((n for n in after if n not in before), None)
        if not new_name:
            die("não consegui identificar a conexão recém-importada — confira 'nmcli connection show'")

        subprocess.run(["nmcli", "connection", "modify", new_name, "connection.id", VPN_CONN_NAME], check=True)
        subprocess.run(["nmcli", "connection", "modify", VPN_CONN_NAME, "wireguard.private-key-flags", "1"], check=True)
    finally:
        tmp.unlink(missing_ok=True)

    log(f"conexão '{VPN_CONN_NAME}' importada, chave privada movida pro chaveiro")
    return subprocess.run(["nmcli", "connection", "up", VPN_CONN_NAME]).returncode


def patch_config(cfg_file: Path, server: dict) -> None:
    """Preenche homeserver.address/domain, appservice.address/hostname e bridge.permissions
    no lugar dos placeholders de exemplo, quando ainda estão intocados. Pontes legadas (sem
    esse template) ou configs já editados à mão são deixados em paz.

    homeserver.address e appservice.address são direções opostas: a primeira é a ponte
    chamando o Synapse (tráfego de saída normal, funciona com a URL pública HTTPS); a
    segunda é o Synapse chamando de volta a ponte (só chega via VPN, por isso usa o IP
    WireGuard). appservice.hostname também vira o IP da VPN, pra ponte só escutar ali
    em vez de todas as interfaces."""
    domain = server.get("homeserver_domain")
    address = server.get("homeserver_address")
    vpn_ip = server.get("vpn_ip")
    owner = server.get("owner_mxid")
    if not domain or not address:
        return

    text = cfg_file.read_text()
    before = text

    # Two different literal placeholders show up here depending on how the
    # config was generated: bridgev2 bridges' "-e" auto-config uses
    # "http://example.localhost:8008"; the plain example-config.yaml a
    # legacy bridge (mautrix-discord) asks you to fetch by hand uses
    # "https://matrix.example.com" instead.
    text = re.sub(
        r"^(\s*)address: (?:http://example\.localhost:8008|https://matrix\.example\.com)\s*$",
        rf"\1address: {address}", text, count=1, flags=re.M,
    )
    text = re.sub(
        r"^(\s*)domain: example\.com\s*$",
        rf"\1domain: {domain}", text, count=1, flags=re.M,
    )
    text = text.replace('"example.com": user', f'"{domain}": user')
    if owner:
        text = text.replace('"@admin:example.com": admin', f'"{owner}": admin')

    # The example config's database placeholder is a postgres URI that was
    # never meant to be run as-is — untouched, the bridge dies at startup
    # with "appservice.database not configured". A single-person bridge has
    # no reason to run postgres at all, so point it at a local sqlite file
    # next to config.yaml instead (bridgev2 bridges accept "sqlite3-fk-wal").
    text = re.sub(r"^(\s*)type: postgres\s*$", r"\1type: sqlite3-fk-wal", text, count=1, flags=re.M)
    text = re.sub(
        r"^(\s*)uri: postgres://user:password@host/database\S*\s*$",
        rf"\1uri: file:{cfg_file.parent / (cfg_file.parent.name + '.db')}?_txlock=immediate",
        text, count=1, flags=re.M,
    )

    if vpn_ip:
        text = re.sub(
            r"^(\s*)address: http://localhost:(\d+)\s*$",
            rf"\1address: http://{vpn_ip}:\2", text, count=1, flags=re.M,
        )
        text = re.sub(
            r"^(\s*)hostname: 127\.0\.0\.1\s*$",
            rf"\1hostname: {vpn_ip}", text, count=1, flags=re.M,
        )
    else:
        log(f"{cfg_file.name}: sem vpn_ip em [server] (rode 'bridgectl init' de novo) — "
            f"appservice.address/hostname continuam em localhost, o Synapse não vai "
            f"conseguir chamar a ponte de volta")

    if text == before:
        log(f"{cfg_file.name}: não encontrei os placeholders de exemplo (example.com/example.localhost) "
            f"— confira homeserver.address/domain e bridge.permissions à mão")
        return
    cfg_file.write_text(text)
    log(f"{cfg_file.name}: homeserver.address/domain, appservice.address/hostname e "
        f"bridge.permissions preenchidos")


def _section_span(text: str, section: str) -> tuple[int, int] | None:
    """Char offsets (start, end) of a top-level `section:` block's body — from
    right after its header line to right before the next top-level (unindented)
    line, or EOF. No YAML parser here on purpose (same reasoning as harvest/
    patch_config): this file is meant to stay hand-editable, so we only ever
    touch specific known lines with plain text/regex, never rewrite the whole
    structure."""
    m = re.search(rf"(?m)^{re.escape(section)}:\s*$", text)
    if not m:
        return None
    start = m.end() + 1
    m2 = re.search(r"(?m)^\S", text[start:])
    end = start + m2.start() if m2 else len(text)
    return start, end


def _nested_span(text: str, key: str) -> tuple[int, int] | None:
    """Like _section_span, but for a `key:` block at ANY indentation, not
    just top-level (column 0) — needed for keys nested more than one level
    deep, e.g. discord's bridge.encryption (whatsapp/slack keep the same
    key at top level, so _section_span already covers those). Bounded by
    the next line whose indentation is the same as or shallower than the
    key's own line."""
    m = re.search(rf"(?m)^([ \t]*){re.escape(key)}:\s*$", text)
    if not m:
        return None
    indent = m.group(1)
    start = m.end() + 1
    for m2 in re.finditer(r"(?m)^([ \t]*)\S", text[start:]):
        if len(m2.group(1)) <= len(indent):
            return start, start + m2.start()
    return start, len(text)


# How much message history to backfill when a portal is first created —
# every bridge type ships this OFF or ON differently by default (confirmed
# against each bridge's actual example-config.yaml this session): Discord
# defaults to fully disabled (0), while WhatsApp/Slack already default to
# unlimited. Offered as a one-time choice during 'setup' (a fresh config
# only — see cmd_setup) instead of leaving everyone to discover and hand-edit
# this after the fact. Each bridge type's schema is completely different
# (bridgev2 unified nothing here), so this is a real per-type table, not one
# generic knob.
BACKFILL_PRESETS = {
    "discord": {
        "none": {"initial": (0, 0, 0), "missed": (0, 0, 0)},
        "limited": {"initial": (20, 20, 0), "missed": (-1, -1, -1)},
        "all": {"initial": (500, 500, 0), "missed": (-1, -1, -1)},
    },
    "whatsapp": {
        "none": {"max_initial_conversations": 0},
        "limited": {"max_initial_conversations": 20},
        "all": {"max_initial_conversations": -1},
    },
    "slack": {
        "none": {"conversation_count": 0},
        "limited": {"conversation_count": 20},
        "all": {"conversation_count": -1},
    },
}


def _replace_indented_triplet(text: str, anchor_key: str, dm: int, channel: int, thread: int) -> str:
    """Discord's backfill.forward_limits.{initial,missed} blocks — each is
    `<key>:` followed immediately by its own dm/channel/thread lines, in that
    fixed order (matches the shipped example-config.yaml exactly). Replaces
    the three value lines under one such block, wherever it's indented."""
    pattern = re.compile(
        rf"(?m)^(\s*){re.escape(anchor_key)}:\s*\n"
        rf"(\s+)dm:\s*.*\n"
        rf"\s+channel:\s*.*\n"
        rf"\s+thread:\s*.*\n"
    )

    def repl(m: re.Match) -> str:
        outer, inner = m.group(1), m.group(2)
        return f"{outer}{anchor_key}:\n{inner}dm: {dm}\n{inner}channel: {channel}\n{inner}thread: {thread}\n"

    new_text, n = pattern.subn(repl, text, count=1)
    return new_text if n else text


def apply_backfill_preset(cfg_file: Path, bridge_type: str, preset: str) -> bool:
    """Patches the backfill knob(s) for one bridge type to one of
    BACKFILL_PRESETS's presets. Returns whether anything actually changed —
    each bridge's fields are matched by fixed structure (see
    _replace_indented_triplet/set_in_section-style single-key replace), not
    a real YAML parser, same reasoning as the rest of this file."""
    fields = BACKFILL_PRESETS.get(bridge_type, {}).get(preset)
    if not fields:
        return False
    text = cfg_file.read_text()

    if bridge_type == "discord":
        dm, channel, thread = fields["initial"]
        text = _replace_indented_triplet(text, "initial", dm, channel, thread)
        dm, channel, thread = fields["missed"]
        text = _replace_indented_triplet(text, "missed", dm, channel, thread)
    elif bridge_type == "whatsapp":
        span = _section_span(text, "history_sync")
        if span:
            section_text, n = re.subn(
                r"(?m)^(\s*)max_initial_conversations:\s*.*$",
                lambda m: f"{m.group(1)}max_initial_conversations: {fields['max_initial_conversations']}",
                text[span[0]:span[1]], count=1,
            )
            text = text[:span[0]] + section_text + text[span[1]:] if n else text
    elif bridge_type == "slack":
        span = _section_span(text, "backfill")
        if span:
            section_text, n = re.subn(
                r"(?m)^(\s*)conversation_count:\s*.*$",
                lambda m: f"{m.group(1)}conversation_count: {fields['conversation_count']}",
                text[span[0]:span[1]], count=1,
            )
            text = text[:span[0]] + section_text + text[span[1]:] if n else text

    cfg_file.write_text(text)
    return True


def maybe_reconfigure_backfill(cfg_file: Path, bridge_type: str) -> None:
    """For a config that already exists (cmd_setup's 'else' branch) — unlike
    the fresh-config path, this never touches anything unless explicitly
    asked, since the current values might already be a deliberate choice
    made earlier (by this same prompt, or by hand)."""
    if bridge_type not in BACKFILL_PRESETS:
        return
    if input(f"\nQuer ajustar quanto histórico a ponte de {bridge_type} carrega em conversas "
              f"novas? [s/N]: ").strip().lower() not in ("s", "sim", "y", "yes"):
        return
    preset = prompt_backfill_preset(bridge_type)
    if preset and apply_backfill_preset(cfg_file, bridge_type, preset):
        log(f"{cfg_file.name}: backfill ajustado para '{preset}'")


def prompt_backfill_preset(bridge_type: str) -> str | None:
    """Interactive one-time choice, only for bridge types BACKFILL_PRESETS
    knows how to patch — silently skipped (returns None) for anything else,
    same as fetch_pool_slot does for bridges outside the pool."""
    if bridge_type not in BACKFILL_PRESETS:
        return None
    print("\nQuanto histórico carregar quando uma conversa for descoberta pela primeira vez?")
    print("  1. nada (padrão mais seguro/rápido — dá pra ajustar depois à mão em config.yaml)")
    print("  2. um pouco (as últimas ~20 mensagens de cada conversa)")
    print("  3. tudo que der (primeira sincronização mais lenta/pesada)")
    choice = input("Escolha [1/2/3, padrão 1]: ").strip() or "1"
    return {"1": "none", "2": "limited", "3": "all"}.get(choice, "none")


# Ghost displayname template per bridge type — confirmed against each
# bridge's real example-config.yaml this session. Appends a fixed platform
# suffix to whatever name the bridge would otherwise use, so a contact from
# any bridge reads "Nome Sobrenome (discord)"/"(slack)"/"(wapp)" instead of
# looking identical to a native stoa user. (section, key, new value) — the
# section differs per bridge (discord keeps this under the legacy `bridge:`
# block; whatsapp/slack, on the newer bridgev2 framework, put connector-
# specific fields like this one under `network:` instead).
DISPLAYNAME_TEMPLATES = {
    "discord": ("bridge", "displayname_template",
                "'{{if .Webhook}}Webhook{{else}}{{or .GlobalName .Username}}{{if .Bot}} (bot){{end}}{{end}} (discord)'"),
    "whatsapp": ("network", "displayname_template",
                 '\'{{or .BusinessName .PushName .Phone .RedactedPhone "Unknown user"}} (wapp)\''),
    "slack": ("network", "displayname_template",
              "'{{or .Profile.DisplayName .Profile.RealName .Name}}{{if .IsBot}} (bot){{end}} (slack)'"),
}

# WhatsApp/Slack (bridgev2) can drop the umbrella "everything" space while
# keeping per-workspace/guild spaces — confirmed in mautrix/go's shared
# bridgev2/space.go: `bridge.personal_filtering_spaces` only gates that one
# umbrella space; per-team/guild spaces are unconditional and unaffected.
# Discord's equivalent umbrella space has NO config toggle at all — it's
# hardcoded in user.go/guildportal.go, so there's nothing to patch there;
# leaving that one space once (as its owner already found out how to do) is
# the only option short of forking the bridge itself.
DISABLE_UMBRELLA_SPACE = {"whatsapp", "slack"}

# End-to-end encryption, on by default for all three pool bridge types —
# Element already encrypts new private/DM rooms by default, and without this
# the bridge simply can't take part in them ("End-to-end encryption isn't
# enabled"). Confirmed against each bridge's real example-config.yaml:
# discord (legacy framework) nests this under `bridge.encryption`; whatsapp/
# slack (bridgev2, shared mautrix/go framework) have `encryption:` as its
# own top-level section instead, sibling to `bridge:`. `allow: true` alone
# is enough for encryption to work; `appservice: true` (inside encryption)
# plus the top-level `appservice.ephemeral_events: true` (shared by all
# three, and named the same as the boolean above purely by coincidence —
# they're unrelated keys in unrelated sections) switch on MSC2409 to-device
# delivery instead of plain /sync polling, which the docs recommend pairing
# with it.
def apply_house_style(cfg_file: Path, bridge_type: str) -> bool:
    """Displayname suffix (all three) + no umbrella space (whatsapp/slack
    only — see DISABLE_UMBRELLA_SPACE) + encryption on by default (all
    three — see POOL_BRIDGE_TYPES). Returns whether anything changed."""
    text = cfg_file.read_text()
    before = text

    tmpl = DISPLAYNAME_TEMPLATES.get(bridge_type)
    if tmpl:
        section, key, value = tmpl
        span = _section_span(text, section)
        if span:
            section_text, n = re.subn(
                rf"(?m)^(\s*){key}:\s*.*$",
                lambda m: f"{m.group(1)}{key}: {value}",
                text[span[0]:span[1]], count=1,
            )
            if n:
                text = text[:span[0]] + section_text + text[span[1]:]

    if bridge_type in DISABLE_UMBRELLA_SPACE:
        span = _section_span(text, "bridge")
        if span:
            section_text, n = re.subn(
                r"(?m)^(\s*)personal_filtering_spaces:\s*.*$",
                lambda m: f"{m.group(1)}personal_filtering_spaces: false",
                text[span[0]:span[1]], count=1,
            )
            if n:
                text = text[:span[0]] + section_text + text[span[1]:]

    if bridge_type in POOL_BRIDGE_TYPES:
        enc_start = enc_end = None
        if bridge_type == "discord":
            bridge_span = _section_span(text, "bridge")
            if bridge_span:
                nested = _nested_span(text[bridge_span[0]:bridge_span[1]], "encryption")
                if nested:
                    enc_start = bridge_span[0] + nested[0]
                    enc_end = bridge_span[0] + nested[1]
        else:  # whatsapp/slack (bridgev2): encryption is its own top-level section
            enc_span = _section_span(text, "encryption")
            if enc_span:
                enc_start, enc_end = enc_span

        if enc_start is not None:
            section_text = text[enc_start:enc_end]
            section_text, n1 = re.subn(
                r"(?m)^(\s*)allow:\s*.*$", lambda m: f"{m.group(1)}allow: true", section_text, count=1,
            )
            section_text, n2 = re.subn(
                r"(?m)^(\s*)appservice:\s*.*$", lambda m: f"{m.group(1)}appservice: true", section_text, count=1,
            )
            if n1 or n2:
                text = text[:enc_start] + section_text + text[enc_end:]

        appservice_span = _section_span(text, "appservice")
        if appservice_span:
            section_text, n = re.subn(
                r"(?m)^(\s*)ephemeral_events:\s*.*$",
                lambda m: f"{m.group(1)}ephemeral_events: true",
                text[appservice_span[0]:appservice_span[1]], count=1,
            )
            if n:
                text = text[:appservice_span[0]] + section_text + text[appservice_span[1]:]

    if text == before:
        return False
    cfg_file.write_text(text)
    return True


def resync_config(cfg_file: Path, server: dict) -> bool:
    """For a config.yaml that already has real values (not patch_config's
    original example placeholders — those only ever get patched once), offer
    to bring homeserver.address/domain and appservice.address/hostname back
    in line with the CURRENT [server] values. Needed after editing those with
    'bridgectl init' again: patch_config alone would silently do nothing the
    second time, since its regexes only match the placeholder text, not
    whatever real value is already there. Returns whether anything changed."""
    domain = server.get("homeserver_domain")
    address = server.get("homeserver_address")
    vpn_ip = server.get("vpn_ip")
    if not domain or not address:
        return False

    text = cfg_file.read_text()

    def get_current(section: str, key: str) -> str | None:
        span = _section_span(text, section)
        if not span:
            return None
        m = re.search(rf"(?m)^\s*{key}:\s*(.+?)\s*$", text[span[0]:span[1]])
        return m.group(1).strip('"').strip("'") if m else None

    wanted = {("homeserver", "address"): address, ("homeserver", "domain"): domain}
    cur_as_address = get_current("appservice", "address")
    port_match = re.search(r":(\d+)$", cur_as_address) if cur_as_address else None
    if vpn_ip and port_match:
        wanted[("appservice", "address")] = f"http://{vpn_ip}:{port_match.group(1)}"
        wanted[("appservice", "hostname")] = vpn_ip

    # Same never-actually-configured postgres placeholder patch_config now
    # fixes on new setups (see there) — caught here too so a config.yaml
    # generated before that fix existed still gets it, without regenerating
    # the whole file. "appservice.database not configured" at startup is
    # the symptom if this never runs. Keyed on "type" alone, not "uri" —
    # "uri" is in HARVEST_KEYS (cmd_setup calls cmd_harvest right after this),
    # so on an already-broken config it's usually already "${keyring:uri}"
    # by now (the *placeholder* got harvested as if it were a real secret,
    # not the actual bug), which would never match a check for the raw
    # placeholder text. "type" is never a harvested field, so it's still a
    # reliable signal here — and this project has no legitimate reason for
    # a single-person bridge to run real postgres, so "still says postgres"
    # alone is enough to act on regardless of what "uri" currently shows.
    if get_current("appservice", "type") == "postgres":
        wanted[("appservice", "type")] = "sqlite3-fk-wal"
        wanted[("appservice", "uri")] = f"file:{cfg_file.parent / (cfg_file.parent.name + '.db')}?_txlock=immediate"

    diffs = []
    for (section, key), new_value in wanted.items():
        current = get_current(section, key)
        if current is not None and current != new_value:
            diffs.append((section, key, current, new_value))

    if not diffs:
        return False

    print(f"\n{cfg_file.name} tem valores diferentes do [server] atual:")
    for section, key, current, new_value in diffs:
        print(f"  {section}.{key}: {current}  ->  {new_value}")
    if input("Atualizar esses campos? [s/N]: ").strip().lower() not in ("s", "sim", "y", "yes"):
        return False

    for section, key, _current, new_value in diffs:
        span = _section_span(text, section)
        section_text = re.sub(
            rf"(?m)^(\s*){key}:\s*.+?\s*$",
            lambda m: f"{m.group(1)}{key}: {new_value}",
            text[span[0]:span[1]], count=1,
        )
        text = text[:span[0]] + section_text + text[span[1]:]

    cfg_file.write_text(text)
    log(f"{cfg_file.name}: campos atualizados pro valor atual de [server]")
    return True


# Pontes que o servidor já pré-registra em lote (ver roles/metroon/files/app/src/
# bridge-pool.js no repo agorae e docs/ADICIONAR-PONTE.md "Pool de pontes") —
# pra essas, 'setup' busca credenciais reais do servidor em vez de gerar (e
# precisar mandar pro administrador) as suas próprias.
POOL_BRIDGE_TYPES = {"discord", "slack", "whatsapp"}


def fetch_pool_slot(cfg: dict, bridge_type: str) -> dict | None:
    """Busca no propylaia o slot pré-registrado deste tipo de ponte, se houver
    um (ver POOL_BRIDGE_TYPES). None quando essa ponte não está no pool
    (segue o fluxo antigo, sem erro) — die() nos outros casos, já que aí a
    intenção clara era usar o pool e algo saiu errado."""
    if bridge_type not in POOL_BRIDGE_TYPES:
        return None
    domain = cfg.get("server", {}).get("homeserver_domain")
    if not domain:
        return None
    token = keyring_mod().get_password(PROPYLAIA_KEYRING_SERVICE, PROPYLAIA_KEYRING_KEY)
    if not token:
        log(f"sem token de API do propylaia (rode 'bridgectl vpn-init') — gerando um registro novo "
            f"pra {bridge_type} em vez de usar o pool pré-registrado")
        return None
    url = f"https://metroon.{domain}/api/bridge-pool/{bridge_type}"
    req = urllib.request.Request(url, headers={
        "User-Agent": UA, "Accept": "application/json", "Authorization": f"Bearer {token}",
    })
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            return json.load(resp)
    except urllib.error.HTTPError as e:
        if e.code == 404:
            return None
        if e.code == 409:
            die(f"pool de {bridge_type} esgotado no servidor — avise o administrador pra "
                f"expandir em /admin (seção 'Pool de pontes')")
        if e.code == 401:
            die("token de API do propylaia inválido ou ausente — rode 'bridgectl vpn-init' "
                "de novo e cole o token atual mostrado em /propylaia")
        die(f"propylaia respondeu {e.code} buscando o slot de {bridge_type}: {e.reason}")
    except (urllib.error.URLError, TimeoutError) as e:
        log(f"não consegui contatar o propylaia ({e}) — gerando um registro novo pra "
            f"{bridge_type} em vez de usar o pool pré-registrado")
        return None


def apply_pool_config(cfg_file: Path, pool_slot: dict, server: dict) -> None:
    """Aponta config.yaml pra escutar exatamente onde a `url` do slot promete
    ao Synapse, e usa o username_template/bot_username reservados só pra esse
    slot — sem isso, duas pessoas com o mesmo tipo de ponte teriam o mesmo
    namespace de fantasmas no Synapse (ver docs/ADICIONAR-PONTE.md "Pool de
    pontes"). as_token/hs_token também precisam bater com o registration.yaml
    do pool exatamente, senão o Synapse não reconhece a ponte."""
    from urllib.parse import urlparse
    port = urlparse(pool_slot["url"]).port
    text = cfg_file.read_text()

    def set_in_section(text: str, section: str, key: str, value: str) -> str:
        span = _section_span(text, section)
        if not span:
            return text
        new_section, n = re.subn(
            rf"(?m)^(\s*){re.escape(key)}:\s*.*$",
            lambda m: f"{m.group(1)}{key}: {value}",
            text[span[0]:span[1]], count=1,
        )
        return text[:span[0]] + new_section + text[span[1]:] if n else text

    text = set_in_section(text, "appservice", "id", pool_slot["id"])
    text = set_in_section(text, "appservice", "address", pool_slot["url"])
    text = set_in_section(text, "appservice", "hostname", "0.0.0.0")
    text = set_in_section(text, "appservice", "port", str(port))
    text = set_in_section(text, "appservice", "username", pool_slot["bot_username"])
    text = set_in_section(text, "appservice", "as_token", f'"{pool_slot["as_token"]}"')
    text = set_in_section(text, "appservice", "hs_token", f'"{pool_slot["hs_token"]}"')
    text = set_in_section(text, "bridge", "username_template", f"'{pool_slot['username_template']}'")

    # patch_config's first pass grants "user" to the WHOLE homeserver domain
    # (`"<domain>": user` in bridge.permissions) — fine for a bridge with one
    # owner, but for a pool slot that would let ANY other student DM this
    # specific bot (e.g. @discordbot_s003) and link their own account through
    # it, defeating the entire point of one appservice per student (ver
    # docs/ADICIONAR-PONTE.md e docs/ARQUITETURA-PONTES.md). Narrow that one
    # entry down to just this slot's real owner, resolved server-side via
    # Synapse's threepid index (never guessed from the email).
    owner_mxid = pool_slot.get("owner_mxid")
    domain = server.get("homeserver_domain")
    if owner_mxid and domain:
        wide = f'"{domain}": user'
        narrow = f'"{owner_mxid}": user'
        if wide in text:
            text = text.replace(wide, narrow, 1)
        elif narrow not in text:
            log(f"{cfg_file.name}: não achei a permissão \"{domain}\": user em bridge.permissions pra "
                f"restringir ao dono — confira à mão se só {owner_mxid} tem nível 'user'")
    else:
        log(f"{cfg_file.name}: servidor não mandou owner_mxid — bridge.permissions continua liberado "
            f"pra todo mundo em {domain or 'todo o domínio'} (atualize o metroon)")

    cfg_file.write_text(text)
    log(f"{cfg_file.name}: appservice.address/hostname/port/tokens/bot.username, "
        f"bridge.username_template e permissions ajustados pro slot do pool")


def cmd_setup(cfg: dict, args: argparse.Namespace) -> int:
    """Um comando só: baixa o binário, gera config+registration, preenche os dados do
    servidor e move os segredos pro chaveiro. Ao final só falta copiar o registration
    pro Synapse e ativar o systemd."""
    b = get_bridge(cfg, args.name)
    server = cfg.get("server", {})
    if not server.get("homeserver_domain") or not server.get("homeserver_address"):
        die("rode 'bridgectl init' primeiro (dados do servidor ainda não configurados)")

    binary = BIN_DIR / b["binary"]
    if not binary.exists():
        cmd_update(cfg, argparse.Namespace(name=args.name, all=False, force=True, quiet=False))

    dst = CONFIG_DIR / args.name
    cfg_file = dst / "config.yaml"
    reg_file = dst / "registration.yaml"

    if not cfg_file.exists():
        rc = cmd_bootstrap(cfg, argparse.Namespace(name=args.name, force=False, quiet_hint=True))
        if rc != 0:
            die(f"{args.name}: gere {cfg_file} manualmente (ver mensagem acima) e rode 'bridgectl setup {args.name}' de novo")
        patch_config(cfg_file, server)
        if apply_house_style(cfg_file, b["repo"]):
            log(f"{args.name}: nome com sufixo de plataforma"
                + (" e space geral desativado" if b["repo"] in DISABLE_UMBRELLA_SPACE else "")
                + (" e encryption ligada" if b["repo"] in POOL_BRIDGE_TYPES else "")
                + " aplicados (padrão do projeto)")
        preset = prompt_backfill_preset(b["repo"])
        if preset and apply_backfill_preset(cfg_file, b["repo"], preset):
            log(f"{args.name}: backfill ajustado para '{preset}'")
    else:
        log(f"{args.name}: config já existe, mantido")
        resync_config(cfg_file, server)
        maybe_reconfigure_backfill(cfg_file, b["repo"])
        if b["repo"] in DISPLAYNAME_TEMPLATES and input(
            f"\nQuer aplicar o nome com sufixo de plataforma"
            + (" e desativar o space geral" if b["repo"] in DISABLE_UMBRELLA_SPACE else "")
            + (" e ligar encryption" if b["repo"] in POOL_BRIDGE_TYPES else "")
            + f" nessa ponte de {b['repo']}? [s/N]: "
        ).strip().lower() in ("s", "sim", "y", "yes"):
            if apply_house_style(cfg_file, b["repo"]):
                log(f"{args.name}: ajustado")

    def registered_id(path: Path) -> str | None:
        m = re.search(r"(?m)^id:\s*(.+?)\s*$", path.read_text())
        return m.group(1).strip('"').strip("'") if m else None

    def configured_appservice_id(path: Path) -> str | None:
        # config.yaml has its OWN separate appservice.id (used by the bridge
        # itself to build the /_matrix/client/v1/appservice/{id}/ping URL) —
        # independent of registration.yaml's id, and apply_pool_config could
        # easily fix one without the other in an earlier bridgectl version,
        # which is exactly the "Mismatching application service ID in path"
        # 403 this also guards against.
        text = path.read_text()
        span = _section_span(text, "appservice")
        if not span:
            return None
        m = re.search(r"(?m)^\s*id:\s*(.+?)\s*$", text[span[0]:span[1]])
        return m.group(1).strip('"').strip("'") if m else None

    def permissions_scoped_to_owner(path: Path, domain: str | None) -> bool:
        # patch_config's first pass grants bridge.permissions "user" to the
        # WHOLE domain (fine for a legacy single-owner bridge) — apply_pool_config
        # narrows that one entry down to the slot's real owner. A config.yaml
        # written by a bridgectl version older than that fix still has the
        # wide grant, which lets any other student command this specific bot.
        if not domain:
            return True  # can't tell without a domain to check against
        text = path.read_text()
        span = _section_span(text, "bridge")
        if not span:
            return True
        return f'"{domain}": user' not in text[span[0]:span[1]]

    # Sempre confere o pool primeiro, mesmo se registration.yaml já existe —
    # um arquivo gerado antes do pool existir (ou pra outro slot, ou antes
    # de um fix do bridgectl) tem um as_token/id que o Synapse não reconhece
    # mais depois que o pool foi aplicado (sintomas: "M_UNKNOWN_TOKEN: Token
    # is not active" ou "Mismatching application service ID in path" no log
    # do systemd), e sem essa checagem 'setup' nunca mais tentaria corrigir
    # isso sozinho. O mesmo vale pra bridge.permissions ainda liberado pro
    # domínio inteiro (ver permissions_scoped_to_owner acima) — reaplica o
    # slot do pool de novo pra estreitar isso, mesmo com os ids já batendo.
    pool_slot = fetch_pool_slot(cfg, b["repo"])
    existing_reg_id = registered_id(reg_file) if reg_file.exists() else None
    existing_cfg_id = configured_appservice_id(cfg_file) if cfg_file.exists() else None
    ids_match = existing_reg_id == pool_slot["id"] and existing_cfg_id == pool_slot["id"] if pool_slot else False
    perms_scoped = (
        not pool_slot.get("owner_mxid")
        or permissions_scoped_to_owner(cfg_file, server.get("homeserver_domain"))
    ) if (pool_slot and cfg_file.exists()) else True
    in_sync = ids_match and perms_scoped

    if pool_slot and in_sync:
        pool_slot = None  # já é o slot certo dos dois lados, nada a fazer
        if reg_file.exists():
            log(f"{args.name}: já é o slot do pool ({existing_reg_id}), mantido")

    if pool_slot and reg_file.exists():
        if not ids_match:
            print(f"\n{args.name}: config atual (registration id: {existing_reg_id}, appservice.id no "
                  f"config.yaml: {existing_cfg_id}) não bate com o slot do pool pré-registrado (id: "
                  f"{pool_slot['id']}) — geralmente porque foi gerado (ou ajustado por uma versão mais "
                  f"antiga do bridgectl) antes disso ser corrigido. O Synapse não reconhece esse estado.")
        else:
            print(f"\n{args.name}: bridge.permissions ainda libera \"{server.get('homeserver_domain')}\": "
                  f"user (todo aluno do domínio, não só você) — config gerado antes desse ajuste existir. "
                  f"Não afeta o Synapse, mas deixa esse bot aceitando comando de qualquer aluno, não só "
                  f"{pool_slot.get('owner_mxid', 'você')}.")
        if input(f"Corrigir pro slot do pool ({pool_slot['id']})? [S/n]: ").strip().lower() not in (
            "", "s", "sim", "y", "yes"
        ):
            log(f"{args.name}: mantido como está "
                + ("(pode continuar dando erro de token/ID)" if not ids_match else
                   "(bridge.permissions continua liberado pro domínio inteiro)"))
            pool_slot = None

    if pool_slot:
        reg_file.write_text(pool_slot["registration_yaml"])
        os.chmod(reg_file, 0o600)
        apply_pool_config(cfg_file, pool_slot, server)
        log(f"{args.name}: registration.yaml = slot do pool pré-registrado ({pool_slot['id']})")
    elif not reg_file.exists():
        import subprocess
        r = subprocess.run(
            [str(binary), "-c", str(cfg_file), "-r", str(reg_file), "-g"],
            capture_output=True, text=True,
        )
        if r.returncode != 0 or not reg_file.exists():
            if r.stderr.strip():
                log(r.stderr.strip().splitlines()[-1])
            die(f"{args.name}: não consegui gerar {reg_file} — ajuste {cfg_file} "
                f"(domínio/porta/permissions) e rode 'bridgectl setup {args.name}' de novo")
        os.chmod(reg_file, 0o600)
        log(f"{args.name}: registration.yaml gerado")
    else:
        log(f"{args.name}: registration.yaml já existe, mantido")

    cmd_harvest(cfg, argparse.Namespace(name=args.name, file=str(cfg_file), keys=None, prefix=False))
    cmd_harvest(cfg, argparse.Namespace(name=args.name, file=str(reg_file), keys=None, prefix=False))

    print()
    log(f"{args.name}: pronto. Falta:")
    if b["repo"] in POOL_BRIDGE_TYPES:
        log(f"  1. systemctl --user enable --now mautrix-bridge@{args.name}   "
            f"(nada pra mandar pro administrador — essa ponte já está registrada no servidor)")
    else:
        log(f"  1. 'bridgectl reveal {args.name}' pra pegar o registration.yaml com valores reais "
            f"(o que ficou em {reg_file} tem só placeholder do chaveiro) e mandar pro administrador")
        log(f"  2. systemctl --user enable --now mautrix-bridge@{args.name}")
    return 0


def cmd_status(cfg: dict, args: argparse.Namespace) -> int:
    def secrets_ok(b: dict) -> str:
        probe = b.get("keyring_probe", "as_token")
        try:
            return "ok" if resolve_secret(probe, b["keyring_service"]) else "faltando"
        except Exception:
            return "?"

    rows = []
    for name, b in cfg["bridges"].items():
        st = read_state(name)
        binary = BIN_DIR / b["binary"]
        checked = st.get("checked_at")
        rows.append((
            name,
            st.get("version", "-") if binary.exists() else "não instalado",
            b["channel"],
            f"{int((time.time() - checked) / 60)} min" if checked else "-",
            "ok" if (CONFIG_DIR / name / "config.yaml").exists() else "sem config",
            secrets_ok(b),
        ))
    hdr = ("ponte", "versão", "canal", "checado", "config", "segredos")
    w = [max(len(str(r[i])) for r in [hdr] + rows) for i in range(len(hdr))]
    print("  ".join(h.ljust(w[i]) for i, h in enumerate(hdr)))
    print("  ".join("-" * w[i] for i in range(len(hdr))))
    for r in rows:
        print("  ".join(str(c).ljust(w[i]) for i, c in enumerate(r)))
    print("\n'segredos: faltando' -> rode 'bridgectl setup <ponte>' antes de ativar o systemd dela.")
    return 0


# --------------------------------------------------------------------------- #

def main() -> int:
    p = argparse.ArgumentParser(prog="bridgectl", description="pontes mautrix com chaveiro + auto-update")
    sub = p.add_subparsers(dest="cmd", required=True)

    up = sub.add_parser("update", help="checa e baixa nova versão do binário")
    up.add_argument("name", nargs="?")
    up.add_argument("--all", action="store_true")
    up.add_argument("--force", action="store_true", help="ignora cooldown e reinstala")
    up.add_argument("--quiet", action="store_true")
    up.set_defaults(func=cmd_update)

    rn = sub.add_parser("run", help="renderiza segredos em tmpfs e executa a ponte")
    rn.add_argument("name")
    rn.add_argument("extra", nargs="*", help="argumentos extras para o binário")
    rn.set_defaults(func=cmd_run)

    st = sub.add_parser("set", help="grava um segredo no chaveiro")
    st.add_argument("name")
    st.add_argument("key")
    st.add_argument("value", nargs="?")
    st.add_argument("--service")
    st.set_defaults(func=cmd_set)

    hv = sub.add_parser("harvest", help="move segredos de um yaml para o chaveiro, deixando placeholders")
    hv.add_argument("name")
    hv.add_argument("file")
    hv.add_argument("--keys", help="lista separada por vírgula (default: as_token,hs_token,uri,...)")
    hv.add_argument("--prefix", action="store_true", help="prefixa a chave com o nome da ponte")
    hv.set_defaults(func=cmd_harvest)

    rv = sub.add_parser("reveal", help="imprime o registration.yaml com os valores reais (pra mandar pro administrador)")
    rv.add_argument("name")
    rv.add_argument("--out", help="escreve num arquivo em vez de stdout (permissão 600)")
    rv.set_defaults(func=cmd_reveal)

    bs = sub.add_parser("bootstrap", help="gera config de exemplo para a ponte")
    bs.add_argument("name")
    bs.add_argument("--force", action="store_true")
    bs.set_defaults(func=cmd_bootstrap)

    sub.add_parser("init", help="pergunta os dados do servidor uma vez (usado por 'setup')").set_defaults(func=cmd_init)

    sub.add_parser("vpn-init", help="pergunta os dados do peer WireGuard do servidor uma vez (usado por 'vpn')").set_defaults(func=cmd_vpn_init)
    sub.add_parser("vpn", help="gera/reaproveita sua chave WireGuard e importa a conexão no NetworkManager").set_defaults(func=cmd_vpn)

    sp = sub.add_parser("setup", help="baixa, gera config/registration, preenche servidor e harvesta — tudo de uma vez")
    sp.add_argument("name")
    sp.set_defaults(func=cmd_setup)

    sub.add_parser("status", help="mostra versões instaladas").set_defaults(func=cmd_status)

    args = p.parse_args()
    if getattr(args, "func", None) is cmd_update and not args.all and not args.name:
        die("informe o nome da ponte ou use --all")

    cfg = load_config()
    return args.func(cfg, args)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(130)
